####################################################################################################
# Argo CD CLI — UBI9 image
#
# Produces a minimal image containing only the argocd CLI binary.
# Independent of "make image" — no UI assets, no server-side tools.
#
# Build:
#   make cli-image CLI_DOCKERFILE=Dockerfile.cli.ubi9 IMAGE_TAG=v3.4.4_ubi9
#   # → quay.io/argoproj/argocd-cli:v3.4.4_ubi9
#
# Run:
#   docker run --rm quay.io/argoproj/argocd-cli:v3.4.4_ubi9 version
#   docker run --rm quay.io/argoproj/argocd-cli:v3.4.4_ubi9 --help
####################################################################################################

####################################################################################################
# Go toolchain — pulled from the official Docker image (avoids wget from go.dev at build time)
####################################################################################################
FROM docker.io/library/golang:1.26.0@sha256:fb612b7831d53a89cbc0aaa7855b69ad7b0caf603715860cf538df854d047b84 AS golang

####################################################################################################
# Build stage — compiles the argocd binary on UBI9
# Layers are ordered coarse-to-fine so Docker cache is reused across rebuilds:
#   1. OS packages     — changes only when base image updates
#   2. Go toolchain    — changes only when Go version bumps (copied from golang stage, no wget)
#   3. Go module deps  — changes only when go.sum changes
#   4. Source + build  — changes on every code change
####################################################################################################
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/ubi:latest AS argocd-build

# 1. OS packages
RUN dnf install -y --setopt=install_weak_deps=False \
    git \
    make \
    gcc \
    tar \
    gzip && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# 2. Go toolchain — copied from the official golang image, no external download
COPY --from=golang /usr/local/go /usr/local/go

ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH=/go
ENV GOCACHE=/tmp/go-build

WORKDIR /go/src/github.com/argoproj/argo-cd

# 3. Go module dependencies (cached until go.sum changes)
COPY go.* ./
RUN mkdir -p gitops-engine
COPY gitops-engine/go.* ./gitops-engine
RUN go mod download

# 4. Source + build (UI assets not needed for the CLI binary)
COPY . .
ARG TARGETOS \
    TARGETARCH
ARG GIT_TAG \
    BUILD_DATE \
    GIT_TREE_STATE \
    GIT_COMMIT
RUN GIT_COMMIT=$GIT_COMMIT \
    GIT_TREE_STATE=$GIT_TREE_STATE \
    GIT_TAG=$GIT_TAG \
    BUILD_DATE=$BUILD_DATE \
    GOOS=$TARGETOS \
    GOARCH=$TARGETARCH \
    make argocd-all

####################################################################################################
# Final image — minimal UBI9 with only the argocd CLI binary
####################################################################################################
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

LABEL org.opencontainers.image.source="https://github.com/argoproj/argo-cd"
LABEL org.opencontainers.image.description="Argo CD CLI (UBI9)"

# ca-certificates required for TLS connections to the Argo CD server
RUN microdnf install -y --setopt=install_weak_deps=0 \
    ca-certificates && \
    microdnf clean all && \
    rm -rf /var/cache/dnf

COPY --from=argocd-build /go/src/github.com/argoproj/argo-cd/dist/argocd /usr/local/bin/argocd

USER 65534

ENTRYPOINT ["/usr/local/bin/argocd"]
